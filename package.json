{
  "name": "noren",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "test": "pnpm exec vitest run",
    "near:build": "cd packages/contract && cargo near build non-reproducible-wasm --no-abi",
    "near:test": "cd packages/contract && cargo test -- --test-threads=1",
    "near:quotes": "tsx scripts/near-dry-quotes.ts",
    "near:testnet": "tsx scripts/near-testnet.ts",
    "near:browser": "node scripts/near-browser-check.mjs",
    "near:verify": "bash scripts/near-verify.sh",
    "near:relay": "tsx scripts/near-relay.ts",
    "near:borrow": "node scripts/live-borrow.mjs",
    "near:wallet-cycle": "node scripts/near-wallet-cycle.mjs",
    "test:e2e": "node scripts/near-browser-e2e.mjs",
    "near:stock-prices": "tsx scripts/near-stock-prices.ts",
    "near:stocks:setup": "node scripts/near-stock-setup.mjs",
    "near:stock-payment": "node scripts/near-stock-payment.mjs",
    "test:equity-source": "node --test scripts/test/equity-source.test.mjs",
    "dev:near": "pnpm --filter @noren/web exec vite --host 127.0.0.1 --port 5395 --strictPort",
    "build:near": "pnpm --filter @noren/near-sdk build && pnpm --filter @noren/web build",
    "test:edition": "node scripts/near-edition-e2e.mjs",
    "near:merchant": "tsx packages/merchant/src/server.ts",
    "test:credit-edition": "node scripts/near-credit-edition-e2e.mjs",
    "near:gasless:setup": "node scripts/near-gasless-setup.mjs",
    "near:gasless": "tsx scripts/near-gasless.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "near-api-js": "7.3.1",
    "playwright-core": "1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
